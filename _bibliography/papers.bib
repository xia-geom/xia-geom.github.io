@unpublished{xiao2026nonuniqueness,
  bibtex_show = {true},
  title       = {Nonuniqueness of Model Potentials and Weak Geodesic Rays},
  author      = {Xiao, Xia},
  year        = {2026},
  month       = sep,
  note        = {Submitted},
  arxiv       = {2609.03296},
  abstract    = {We establish two nonuniqueness phenomena on ℂℙ¹. First, distinct normalized positive-mass model potentials can have the same non-pluripolar Monge--Amp\`ere measure. By the contact-set formula, their zero-contact sets agree ω_FS-almost everywhere. Moreover, both have zero Lelong number at every point and identical multiplier ideal sheaves at every positive scale. Second, we construct distinct maximal test curves whose zero-contact sets agree pointwise at every parameter. Their inverse Legendre transforms are distinct bounded weak geodesic rays from zero with the same pointwise right initial tangent.}
}

@unpublished{xiao2026weighted,
  bibtex_show = {true},
  title       = {On Weighted Twisted {K}-Energy and Its Applications},
  author      = {Xiao, Xia},
  year        = {2026},
  month       = feb,
  note        = {Submitted},
  arxiv       = {2602.20302},
  abstract    = {We establish the convexity of the weighted twisted Mabuchi K-energy functional along geodesics in the finite energy space. We then prove that coercivity of this functional is an open condition under cone angle perturbations.}
}
