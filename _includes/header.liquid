{% assign lang = page.lang | default: site.lang %}
{% assign home_url = '/' %}
{% assign about_label = 'About' %}
{% assign menu_label = 'Toggle navigation' %}
{% assign theme_label = 'Change theme' %}
{% assign other_url = '/fr' | append: page.url %}
{% assign other_lang = 'fr' %}
{% assign other_label = 'Français' %}
{% if lang == 'fr' %}
  {% assign home_url = '/fr/' %}
  {% assign about_label = 'À propos' %}
  {% assign menu_label = 'Afficher le menu' %}
  {% assign theme_label = 'Changer le thème' %}
  {% assign other_url = page.url | remove_first: '/fr' %}
  {% assign other_lang = 'en' %}
  {% assign other_label = 'English' %}
{% endif %}
{% assign other_page = site.pages | where: 'url', other_url | first %}
{% unless other_page %}
  {% assign other_url = '/fr/' %}
  {% if lang == 'fr' %}{% assign other_url = '/' %}{% endif %}
{% endunless %}
<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="{% if lang == 'fr' %}Navigation principale{% else %}Main navigation{% endif %}">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">{{ site.title }}</a>
      <button class="navbar-toggler collapsed ml-auto" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="{{ menu_label }}">
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.url == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}" {% if page.url == home_url %}aria-current="page"{% endif %}>{{ about_label }}</a>
          </li>
          {% assign pages = site.pages | sort: 'nav_order' %}
          {% for item in pages %}
            {% if item.nav and item.lang != 'fr' %}
              {% assign nav_url = item.url %}
              {% assign nav_title = item.title %}
              {% if lang == 'fr' %}
                {% assign translated_url = '/fr' | append: item.url %}
                {% assign translated = site.pages | where: 'url', translated_url | first %}
                {% if translated %}
                  {% assign nav_url = translated.url %}
                  {% assign nav_title = translated.title %}
                {% endif %}
              {% endif %}
              <li class="nav-item {% if page.url contains nav_url %}active{% endif %}">
                <a class="nav-link" href="{{ nav_url | relative_url }}" {% if page.url == nav_url %}aria-current="page"{% endif %}>{{ nav_title }}</a>
              </li>
            {% endif %}
          {% endfor %}
          <li class="nav-item">
            <a class="nav-link" href="{{ other_url | relative_url }}" lang="{{ other_lang }}" hreflang="{{ other_lang }}">{{ other_label }}</a>
          </li>
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="{{ theme_label }}" aria-label="{{ theme_label }}">
                <i class="fa-half-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark" aria-hidden="true"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-hidden="true">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
